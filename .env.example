# Spanner & GCP Configuration
GOOGLE_SPANNER_DATABASE=lei-database
GOOGLE_SPANNER_INSTANCE=spanner-instance
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_PROJECT=my-gcp-project-id

# Data & S2 Indexing Settings
JSON_PATH=data/1000.json
S2_LEVELS=6,8,10,12,14,16,18,20
BATCH_SIZE=500

# Loader Flags
DRY_RUN=false
USE_REMOTE_GEOCODER=false
